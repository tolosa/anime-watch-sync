# Run pnpm dev auth login once; pull then renews the saved session automatically.
CR_SESSION_PATH=./data/cr-session.json
# Optional path to Chrome/Edge if it is not installed in the usual location.
# CR_BROWSER_PATH=
# A stable identifier for the selected profile; local isolation only.
CR_PROFILE_ID=default
CR_LOCALE=en-US
# The API is internal. Use the same origin as your browser's watch-history request.
CR_BASE_URL=https://www.crunchyroll.com

# Obtain through your own AniList OAuth application (see README).
ANILIST_ACCESS_TOKEN=
ANILIST_CLIENT_ID=

DATABASE_PATH=./data/watch-history.sqlite
# A finished flag OR this fraction of runtime counts as watched.
WATCHED_THRESHOLD=0.9
